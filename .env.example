# Copy this file to .env.local for local development, and set the same
# values in your hosting provider's environment variable settings for
# production (e.g. Vercel → Project Settings → Environment Variables).
# See ADMIN.md for the full one-time setup walkthrough.

# The password used to log in at /admin. Choose something memorable but not
# guessable — it's the only thing standing between the public internet and
# your portfolio content.
ADMIN_PASSWORD=

# A random string used to sign admin login sessions. Generate one with:
#   openssl rand -hex 32
# Changing this later logs everyone out; that's harmless.
SESSION_SECRET=

# A GitHub Personal Access Token with write access to this repository's
# contents. This is how /admin "publishes" — it commits directly to your
# repo, which your host (e.g. Vercel) then redeploys automatically.
GITHUB_TOKEN=

# owner/repo of this GitHub repository, e.g. chrisjaillet2007/Candlewood
GITHUB_REPO=chrisjaillet2007/Candlewood

# The branch your hosting provider deploys from (commonly "main"). Admin
# changes are committed to this branch.
GITHUB_BRANCH=
